# Melomania - Variables d'environnement

# --- Base de données durable (OBLIGATOIRE en production) ---
# Sans DATABASE_URL, l'app utilise .melomania-db.json en local (dev uniquement).
# Sur Vercel le filesystem est éphémère : chaque déploiement repartirait d'une
# base vide. Crée un projet sur https://neon.tech, copie la "pooled connection
# string", et renseigne-la ici (dev) + dans Vercel Dashboard → Settings →
# Environment Variables (prod). Ne jamais la committer avec de vrais secrets.
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.eu-central-1.aws.neon.tech/melomania?sslmode=require

# Clé secrète de chiffrement AES-256 pour les tokens OAuth connectés (32 caractères minimum)
ENCRYPTION_KEY=melomania-super-secret-key-32-chars-minimum!

# Secret de signature des cookies de session (HMAC-SHA256, 32+ caractères aléatoires).
# OBLIGATOIRE en production. Générer avec : openssl rand -hex 32
# Si absent, ENCRYPTION_KEY est réutilisé (déconseillé).
SESSION_SECRET=

# Cloudflare Turnstile (captcha à l'inscription, surface "signup")
# Widget déjà créé. Clé publique (site key) — exposée au front, non secrète :
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEmQbgATFq6RtfOK
# Secret serveur — à renseigner via Vercel Dashboard → Settings → Environment Variables
# (ne jamais le coller dans le chat ni le committer). Nom canonique :
TURNSTILE_SECRET=
# Compat legacy (si déjà défini sous l'ancien nom, il reste pris en compte) :
# TURNSTILE_SECRET_KEY=
# Hostnames front autorisés pour le check siteverify (CSV, sans localhost en prod) :
# TURNSTILE_HOSTNAMES=melomania.app,www.melomania.app

# Compte admin initial (base neuve uniquement ; sans ces vars, mot de passe aléatoire inutilisable)
# Option A (recommandée) : hash bcrypt déjà calculé
ADMIN_INITIAL_PASSWORD_HASH=
# Option B : mot de passe clair >= 12 caractères (hashé au premier démarrage)
# ADMIN_INITIAL_PASSWORD=

# Optionnel: Spotify Web API credentials (compte dev GRATUIT)
# 1. Crée une app sur https://developer.spotify.com/dashboard
# 2. Dans Settings → Redirect URIs, déclare (une par ligne) :
#      http://localhost:3000/api/spotify/callback
#      https://<ton-domaine>/api/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Apple Music — mode GRATUIT par défaut (recherche iTunes + liens, sans compte).
# Aucune variable requise. La connexion réelle au compte (MusicKit, ajout en
# 1 clic) reste implémentée côté serveur mais exige le programme dev Apple
# payant (~99 €/an). Pour l'activer un jour :
# 1. Crée une clé Media Services sur https://developer.apple.com/account/resources/authkeys/list
#    (cocher "MusicKit"), télécharge le .p8 (une seule fois !), note le Key ID.
# 2. Note le Team ID (Membership details) et renseigne les 3 vars ci-dessous.
# Le developer token JWT (ES256) est généré côté serveur à la demande.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Fallback (optionnel) : coller ici un developer token déjà signé au lieu des 3 vars.
# APPLE_MUSIC_DEVELOPER_TOKEN=

# YouTube Data API v3 — fallback UNIQUEMENT (scraping d'abord).
# Utilisée (1) quand le scraping ne rend rien d'exploitable (échec, liste
# vide ou pagination tronquée) et (2) quand le compteur officiel contredit
# un scraping d'apparence complète (snapshot périmé : ~1 unité pour le
# check, ~8 pour le fetch complet). Coût : 10 000 unités/jour gratuites.
# 1. Google Cloud Console → activer "YouTube Data API v3" → Credentials →
#    Create Credentials → API key → restreindre la clé à cette API.
# 2. Vercel Dashboard → Settings → Environment Variables (jamais committer).
# Désactivable par compte : settings → services → YouTube Data API.
YOUTUBE_API_KEY=
